{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/cron/close-chats",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/notifications/process-pending",
      "schedule": "*/30 * * * *"
    },
    {
      "path": "/api/cron/visit-reminders",
      "schedule": "0 */6 * * *"
    },
    {
      "path": "/api/cron/visit-staffed-notifications",
      "schedule": "15 * * * *"
    }
  ]
}
